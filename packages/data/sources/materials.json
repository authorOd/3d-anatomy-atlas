{
  "$comment": "Display palette. Z-Anatomy materials use custom shader nodes without usable base colours, so colours are assigned here by material name (first matching rule wins). 'vary' shades numbered variants (Bone-1, Bone-2, ...) slightly so neighbouring structures stay distinguishable.",
  "rules": [
    { "match": "^Suture(-\\d+)?$", "kind": "bone", "color": "#cbbd9a", "vary": true },
    { "match": "^Bone(-\\d+)?$", "kind": "bone", "color": "#e6dcc2", "vary": true },
    { "match": "^Teeth-roots$", "kind": "tooth", "color": "#e0d2b2" },
    { "match": "^(Teeth|Dentine)$", "kind": "tooth", "color": "#f4f0e2" },
    { "match": "^Cartilage$", "kind": "cartilage", "color": "#bcd4e0" },
    { "match": "^Articular capsule$", "kind": "ligament", "color": "#cdbf96" },
    { "match": "^Ligament$", "kind": "ligament", "color": "#dccb9f" },
    { "match": "^Tendon$", "kind": "tendon", "color": "#e8dfcc" },
    { "match": "^Fascia$", "kind": "fascia", "color": "#d6cdbd" },
    { "match": "^Bursa$", "kind": "fascia", "color": "#78b4c8" },
    { "match": "^(Origin[- ].*|Muscular origin)$", "kind": "insertion", "color": "#d24b4b" },
    { "match": "^End-.*$", "kind": "insertion", "color": "#4b78d2" },
    { "match": "^Pulmonary artery$", "kind": "artery", "color": "#4c73c0" },
    { "match": "^Pulmonary vein$", "kind": "vein", "color": "#cf4a44" },
    { "match": "^Artery$", "kind": "artery", "color": "#c8322f" },
    { "match": "^Vein$", "kind": "vein", "color": "#3f5fae" },
    { "match": "^Nerve(-\\d+)?$", "kind": "nerve", "color": "#efcf55", "vary": true },
    { "match": "^White matter$", "kind": "brain", "color": "#f1e7da" },
    { "match": "^Nucleus.*$", "kind": "brain", "color": "#b9877b" },
    { "match": "^LCR$", "kind": "fluid", "color": "#7fb9d8" },
    { "match": "^Cerebellum$", "kind": "brain", "color": "#d59b8c" },
    { "match": "^(Brain|Brain-Inner|Frontal lobe|Parietal lobe|Temporal lobe|Occipital lobe|Limbic lobe|Insula|Interlobar sulci)$", "kind": "brain", "color": "#e3a898", "vary": true },
    { "match": "^Cornea$", "kind": "eye", "color": "#d3ebf4" },
    { "match": "^Iris$", "kind": "eye", "color": "#6f8f5c" },
    { "match": "^Eye$", "kind": "eye", "color": "#f4f3ee" },
    { "match": "^Lymph(-\\d+)?$", "kind": "lymph", "color": "#98c05c", "vary": true },
    { "match": "^Gland$", "kind": "gland", "color": "#d98b5c" },
    { "match": "^Lung(-\\d+|-base)?$", "kind": "organ", "color": "#e7a6a3", "vary": true },
    { "match": "^Bronchi(-\\d+)?$", "kind": "organ", "color": "#d7c0b0", "vary": true },
    { "match": "^(Mucosa|Mucosa of stomach)$", "kind": "mucosa", "color": "#d98b8b" },
    { "match": "^Intestine$", "kind": "organ", "color": "#d8937b" },
    { "match": "^Peritoneum$", "kind": "organ", "color": "#e5c8a6" },
    { "match": "^Gallbladder$", "kind": "organ", "color": "#7fa35a" },
    { "match": "^Ductus$", "kind": "organ", "color": "#a4bd62" },
    { "match": "^Renal cortex$", "kind": "organ", "color": "#c47d66" },
    { "match": "^Renal medulla$", "kind": "organ", "color": "#8f3c35" },
    { "match": "^Renal papilla$", "kind": "organ", "color": "#d8a695" },
    { "match": "^Organ(-\\d+)?$", "kind": "organ", "color": "#a9584c", "vary": true },
    { "match": "^Diaphragm$", "kind": "muscle", "color": "#b24c43" },
    { "match": "^Fat$", "kind": "other", "color": "#efd88f" },
    { "match": "^Skin-in$", "kind": "skin", "color": "#b98068" },
    { "match": "^Skin-.*$", "kind": "skin", "color": "#e2b095", "vary": true },
    { "match": "^Nail$", "kind": "skin", "color": "#efd5c6" },
    { "match": "^Black$", "kind": "hair", "color": "#3a2c24" },
    { "match": "^(Abductor|Adductor|Biarticular|Depressor|Extension.*|Extensor extremities|External rotation|Flexion.*|Ingestion|Internal rotator|Levator|Masticator|Orbicularis/Constrictor|Phonation|Superficial|Trapezius)$", "kind": "muscle", "color": "#b54a40", "vary": true }
  ],
  "fallback": { "kind": "other", "color": "#b8b0a8" }
}
