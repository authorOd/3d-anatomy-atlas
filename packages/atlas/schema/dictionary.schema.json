{
  "title": "Svitylo 3D Anatomy Atlas — names dictionary (schemaVersion 1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "lang": {
      "type": "string",
      "enum": [
        "uk",
        "la",
        "en"
      ]
    },
    "model": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9][a-z0-9_]*)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "synonyms": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "unreviewed",
              "reviewed",
              "needs-correction"
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "source",
              "draft",
              "editorial"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "review": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unreviewed",
                  "reviewed",
                  "needs-correction"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "notes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "status",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "missing": {
      "maxItems": 30000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9][a-z0-9_]*)*$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "lang",
    "model",
    "version",
    "entries",
    "missing"
  ],
  "additionalProperties": false
}
