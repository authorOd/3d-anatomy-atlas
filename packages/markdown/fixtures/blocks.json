{
  "$comment": "Shared by the JS (markdown-it, DOM) and PHP (CommonMark, HTML transform) implementations. Each case: text of an ```anatomy block -> parsed spec (or errors) -> exact embed HTML with the options below.",
  "options": {
    "dataUrl": "/anatomy-data/1.0.0/",
    "shareUrls": ["https://svitylo.com/atlas"]
  },
  "cases": [
    {
      "name": "structure with surroundings, view, label and caption",
      "block": "structure: cardiovascular.heart\nsurroundings: 2\nview: anterior\nlabel: Серце\ncaption: Серце в оточенні",
      "spec": { "structure": "cardiovascular.heart", "surroundings": 2, "view": "anterior", "label": "Серце", "caption": "Серце в оточенні" },
      "html": "<figure class=\"svitylo-anatomy-embed\"><svitylo-anatomy layout=\"embed\" data-url=\"/anatomy-data/1.0.0/\" structure=\"cardiovascular.heart\" surroundings=\"2\" view=\"anterior\" label=\"Серце\"></svitylo-anatomy><figcaption>Серце в оточенні</figcaption></figure>"
    },
    {
      "name": "system, height, language and Latin alongside",
      "block": "system: skeletal\nheight: 360\nlang: uk\nlatin: yes",
      "spec": { "system": "skeletal", "height": 360, "lang": "uk", "latin": true },
      "html": "<figure class=\"svitylo-anatomy-embed\"><svitylo-anatomy layout=\"embed\" data-url=\"/anatomy-data/1.0.0/\" system=\"skeletal\" height=\"360\" lang=\"uk\" latin></svitylo-anatomy></figure>"
    },
    {
      "name": "exact view from a share link",
      "block": "link: https://svitylo.com/atlas#s=z1.eJx-abc_09\nlabel: Вигляд",
      "spec": { "state": "z1.eJx-abc_09", "label": "Вигляд" },
      "html": "<figure class=\"svitylo-anatomy-embed\"><svitylo-anatomy layout=\"embed\" data-url=\"/anatomy-data/1.0.0/\" state=\"z1.eJx-abc_09\" label=\"Вигляд\"></svitylo-anatomy></figure>"
    },
    {
      "name": "a share link alone on a line, any atlas site inside a block",
      "block": "https://example.org/anatomy/?data=x#s=j1.eyJ2IjoxfQ",
      "spec": { "state": "j1.eyJ2IjoxfQ" },
      "html": "<figure class=\"svitylo-anatomy-embed\"><svitylo-anatomy layout=\"embed\" data-url=\"/anatomy-data/1.0.0/\" state=\"j1.eyJ2IjoxfQ\"></svitylo-anatomy></figure>"
    },
    {
      "name": "state with a structure keeps both (the state decides the view)",
      "block": "# a comment\nstate: z1.AAAA\n\nstructure: cardiovascular.heart\nlabel: \"Серце: вигляд\"",
      "spec": { "state": "z1.AAAA", "structure": "cardiovascular.heart", "label": "Серце: вигляд" },
      "html": "<figure class=\"svitylo-anatomy-embed\"><svitylo-anatomy layout=\"embed\" data-url=\"/anatomy-data/1.0.0/\" structure=\"cardiovascular.heart\" state=\"z1.AAAA\" label=\"Серце: вигляд\"></svitylo-anatomy></figure>"
    },
    {
      "name": "markup in texts is escaped",
      "block": "structure: cardiovascular.heart\nlabel: <img src=x onerror=alert(1)>\ncaption: \"a\" & 'b' </figcaption><script>",
      "spec": { "structure": "cardiovascular.heart", "label": "<img src=x onerror=alert(1)>", "caption": "\"a\" & 'b' </figcaption><script>" },
      "html": "<figure class=\"svitylo-anatomy-embed\"><svitylo-anatomy layout=\"embed\" data-url=\"/anatomy-data/1.0.0/\" structure=\"cardiovascular.heart\" label=\"&lt;img src=x onerror=alert(1)&gt;\"></svitylo-anatomy><figcaption>&quot;a&quot; &amp; &#39;b&#39; &lt;/figcaption&gt;&lt;script&gt;</figcaption></figure>"
    },
    {
      "name": "unknown and repeated keys are ignored with a warning",
      "block": "structure: cardiovascular.heart\ncolour: red\nstructure: skeletal",
      "spec": { "structure": "cardiovascular.heart" },
      "warnings": ["colour", "structure"],
      "html": "<figure class=\"svitylo-anatomy-embed\"><svitylo-anatomy layout=\"embed\" data-url=\"/anatomy-data/1.0.0/\" structure=\"cardiovascular.heart\"></svitylo-anatomy></figure>"
    },
    { "name": "path tricks in an ID", "block": "structure: ../../etc/passwd", "errors": ["structure"] },
    { "name": "markup in an ID", "block": "structure: heart\"><script>", "errors": ["structure"] },
    { "name": "not a share link", "block": "link: javascript:alert(1)", "errors": ["link"] },
    { "name": "share link without a state", "block": "link: https://svitylo.com/atlas", "errors": ["link"] },
    { "name": "malformed state", "block": "state: z9.abc", "errors": ["state"] },
    { "name": "state with markup", "block": "state: z1.a\"b", "errors": ["state"] },
